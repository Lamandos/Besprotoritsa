{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supply.schema.json",
  "title": "Supply",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "cost", "isConsumable", "behaviorId", "nameKey", "descKey"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "cost": { "$ref": "#/$defs/nonNegativeInteger" },
    "isConsumable": { "type": "boolean" },
    "behaviorId": { "$ref": "#/$defs/id" },
    "nameKey": { "$ref": "#/$defs/localizationKey" },
    "descKey": { "$ref": "#/$defs/localizationKey" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "localizationKey": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 }
  }
}
