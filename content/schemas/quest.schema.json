{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quest.schema.json",
  "title": "Quest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "chapter", "targetLocation", "conditions", "reward", "nextQuestIds", "nameKey", "descKey"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "chapter": { "type": "integer", "minimum": 1 },
    "targetLocation": { "$ref": "#/$defs/id" },
    "conditions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credits", "items"],
      "properties": {
        "credits": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "nextQuestIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "nameKey": { "$ref": "#/$defs/localizationKey" },
    "descKey": { "$ref": "#/$defs/localizationKey" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "localizationKey": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" }
  }
}
