{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quest.schema.json",
  "title": "Quest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "chapter", "conditions", "reward", "nextQuestIds", "nameKey", "descKey"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "number": { "type": "integer", "minimum": 1 },
    "chapter": { "type": "integer", "minimum": 0 },
    "targetLocation": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "conditions": { "type": "array", "uniqueItems": true, "items": { "oneOf": [{ "$ref": "#/$defs/id" }, { "$ref": "#/$defs/condition" }] } },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credits", "items"],
      "properties": {
        "credits": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "nextQuestIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "prerequisiteQuestIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "endsGame": { "type": "boolean" },
    "nameKey": { "$ref": "#/$defs/localizationKey" },
    "descKey": { "$ref": "#/$defs/localizationKey" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "localizationKey": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "locationId"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "enum": ["arrive"] },
            "locationId": { "$ref": "#/$defs/id" },
            "targetValue": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "locationId", "skill"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "enum": ["skill_check"] },
            "locationId": { "$ref": "#/$defs/id" },
            "skill": { "enum": ["strength", "combatStrength", "science", "repair", "endurance", "agility"] },
            "targetValue": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "monsterId"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "enum": ["kill_monster"] },
            "monsterId": { "$ref": "#/$defs/id" },
            "targetValue": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "itemId"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "enum": ["collect_item"] },
            "itemId": { "$ref": "#/$defs/id" },
            "targetValue": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "metric"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "enum": ["counter"] },
            "metric": { "enum": ["damage_tokens_collected", "credits_collected", "agility_check_in_ventilation"] },
            "targetValue": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  }
}
