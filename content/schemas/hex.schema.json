{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hex.schema.json",
  "title": "Hex",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "locationNameKey", "hasTerminal", "ventColor", "exits"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "type": { "enum": ["start", "compartment", "corridor", "airlock"] },
    "locationNameKey": { "$ref": "#/$defs/localizationKey" },
    "hasTerminal": { "type": "boolean" },
    "ventColor": { "$ref": "#/$defs/id" },
    "exits": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0, "maximum": 5 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "localizationKey": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" }
  }
}
