{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "monster.schema.json",
  "title": "Monster",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "health", "defense", "attack", "movement", "rewardCredits", "rewardItems", "behaviorId", "features", "nameKey", "descKey"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "health": { "$ref": "#/$defs/nonNegativeInteger" },
    "defense": { "$ref": "#/$defs/nonNegativeInteger" },
    "attack": { "$ref": "#/$defs/nonNegativeInteger" },
    "activity": { "enum": ["active", "passive"] },
    "movement": { "$ref": "#/$defs/nonNegativeInteger" },
    "rewardCredits": { "$ref": "#/$defs/nonNegativeInteger" },
    "rewardItems": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "behaviorId": { "$ref": "#/$defs/id" },
    "features": { "type": "array", "uniqueItems": true, "items": { "enum": ["blocks-exits", "boss", "explodes-on-colocation", "fast", "flees-from-heroes", "ignores-defense", "moves-through-vents", "reduces-combat-strength", "restores-health-if-alive", "scales-per-alive-monster", "scales-per-hero", "slow", "spawns-adjacent-boils-on-death", "spawns-boil-instead-of-attack", "spawns-two-boils", "stationary", "strong", "targets-lowest-health"] } },
    "copies": { "type": "integer", "minimum": 1 },
    "importBatch": { "type": "integer", "minimum": 1 },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthPerHero", "attackPerHero"],
      "properties": {
        "healthPerHero": { "$ref": "#/$defs/nonNegativeInteger" },
        "attackPerHero": { "$ref": "#/$defs/nonNegativeInteger" },
        "healthPerAliveMonster": { "$ref": "#/$defs/nonNegativeInteger" },
        "attackPerAliveMonster": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "nameKey": { "$ref": "#/$defs/localizationKey" },
    "descKey": { "$ref": "#/$defs/localizationKey" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "localizationKey": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 }
  }
}
