{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "targetType", "metric", "targetValue", "window", "rewardCredits", "nameKey", "descKey"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "targetType": { "$ref": "#/$defs/id" },
    "metric": { "$ref": "#/$defs/id" },
    "targetValue": { "type": "integer", "minimum": 0 },
    "window": { "enum": ["perTurn", "simultaneously", "game"] },
    "aggregation": { "enum": ["sum", "maximum", "max"] },
    "rewardCredits": { "type": "integer", "minimum": 0 },
    "nameKey": { "$ref": "#/$defs/localizationKey" },
    "descKey": { "$ref": "#/$defs/localizationKey" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "localizationKey": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" }
  }
}
