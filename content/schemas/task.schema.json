{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "targetType", "metric", "targetValue", "window", "rewardCredits", "nameKey", "descKey"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "targetType": { "enum": ["metric"] },
    "metric": { "enum": ["boils_popped", "chest_cards", "clothing_and_armor", "combat_strength", "conditions", "credits", "dodges_without_damage", "enemies_killed", "health_at_most", "implants", "map_fragments_open", "robot_reloaded", "roll_successes", "special_items_received", "strong_enemy_solo", "supply_purchase_cost"] },
    "targetValue": { "type": "integer", "minimum": 1 },
    "window": { "enum": ["perTurn", "simultaneously", "game"] },
    "aggregation": { "enum": ["sum", "maximum", "max"] },
    "rewardCredits": { "type": "integer", "minimum": 0 },
    "nameKey": { "$ref": "#/$defs/localizationKey" },
    "descKey": { "$ref": "#/$defs/localizationKey" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "localizationKey": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" }
  }
}
