{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "item.schema.json",
  "title": "Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "slots", "cost", "stats", "nameKey", "descKey"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "category": { "enum": ["weapon", "armor", "clothing", "robot", "modification", "supply"] },
    "slots": { "type": "array", "uniqueItems": true, "items": { "enum": ["weapon", "armor", "clothing", "robot", "modification"] } },
    "cost": { "$ref": "#/$defs/nonNegativeInteger" },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strength": { "type": "integer" },
        "combatStrength": { "type": "integer" },
        "science": { "type": "integer" },
        "repair": { "type": "integer" },
        "endurance": { "type": "integer" },
        "agility": { "type": "integer" },
        "health": { "type": "integer" },
        "defense": { "type": "integer" }
      }
    },
    "range": { "$ref": "#/$defs/nonNegativeInteger" },
    "copies": { "type": "integer", "minimum": 1 },
    "importBatch": { "type": "integer", "minimum": 1 },
    "sourceDeck": { "enum": ["items", "supplies", "starterItems"] },
    "behaviorId": { "$ref": "#/$defs/behaviorId" },
    "behaviorIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/behaviorId" }
    },
    "nameKey": { "$ref": "#/$defs/localizationKey" },
    "descKey": { "$ref": "#/$defs/localizationKey" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "behaviorId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_.-]*$" },
    "localizationKey": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 }
  }
}
