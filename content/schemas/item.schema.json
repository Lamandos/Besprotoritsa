{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "item.schema.json",
  "title": "Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "slots", "cost", "stats", "behaviorId", "nameKey", "descKey"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "category": { "enum": ["weapon", "armor", "clothing", "robot", "modification"] },
    "slots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "cost": { "$ref": "#/$defs/nonNegativeInteger" },
    "stats": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "behaviorId": { "$ref": "#/$defs/id" },
    "nameKey": { "$ref": "#/$defs/localizationKey" },
    "descKey": { "$ref": "#/$defs/localizationKey" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "localizationKey": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 }
  }
}
