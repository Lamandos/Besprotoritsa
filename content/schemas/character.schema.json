{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character.schema.json",
  "title": "Character",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "health", "strength", "combatStrength", "science", "repair", "endurance", "agility", "startItems", "startCredits", "diaryKey"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "health": { "$ref": "#/$defs/nonNegativeInteger" },
    "strength": { "$ref": "#/$defs/nonNegativeInteger" },
    "combatStrength": { "$ref": "#/$defs/nonNegativeInteger" },
    "science": { "$ref": "#/$defs/nonNegativeInteger" },
    "repair": { "$ref": "#/$defs/nonNegativeInteger" },
    "endurance": { "$ref": "#/$defs/nonNegativeInteger" },
    "agility": { "$ref": "#/$defs/nonNegativeInteger" },
    "startItems": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "startCredits": { "$ref": "#/$defs/nonNegativeInteger" },
    "diaryKey": { "$ref": "#/$defs/localizationKey" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "localizationKey": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 }
  }
}
